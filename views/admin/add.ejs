<%- include('../partials/header') %>

<div class="page-header">
  <h1>Add New Notice</h1>
  <a href="/admin" class="btn btn-secondary">&larr; Back to Dashboard</a>
</div>

<div class="form-container">

  <% if (errors.length > 0) { %>
    <div class="error-list">
      <strong>Please fix the following errors:</strong>
      <ul>
        <% errors.forEach(err => { %>
          <li><%= err.msg %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <form action="/admin/notices/add" method="POST">

    <div class="form-group">
      <label for="title">Title <span class="required">*</span></label>
      <input
        type="text"
        id="title"
        name="title"
        value="<%= formData.title || '' %>"
        placeholder="Notice title (min. 5 characters)"
      >
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="category">Category <span class="required">*</span></label>
        <select id="category" name="category">
          <option value="">-- Select Category --</option>
          <% categories.forEach(cat => { %>
            <option value="<%= cat %>" <%= formData.category === cat ? 'selected' : '' %>><%= cat %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="urgency">Urgency <span class="required">*</span></label>
        <select id="urgency" name="urgency">
          <option value="">-- Select Urgency --</option>
          <% urgencies.forEach(urg => { %>
            <option value="<%= urg %>" <%= formData.urgency === urg ? 'selected' : '' %>><%= urg %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <div class="form-group">
      <label for="authorDepartment">Author Department <span class="required">*</span></label>
      <input
        type="text"
        id="authorDepartment"
        name="authorDepartment"
        value="<%= formData.authorDepartment || '' %>"
        placeholder="e.g., Faculty of CS, Office of Registrar"
      >
    </div>

    <div class="form-group">
      <label for="content">Notice Content <span class="required">*</span></label>
      <textarea
        id="content"
        name="content"
        rows="6"
        placeholder="Full notice body text (min. 15 characters)"
      ><%= formData.content || '' %></textarea>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Post Notice</button>
      <a href="/admin" class="btn btn-secondary">Cancel</a>
    </div>

  </form>
</div>

<%- include('../partials/footer') %>
